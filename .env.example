# ─── PostgreSQL ───────────────────────────────────────────────
# Локально:
# DATABASE_URL=postgres://school37:school37@localhost:5432/school37
#
# Vercel + Neon (рекомендуется): создайте проект на https://neon.tech
# Используйте pooled connection string (порт 5432, суффикс -pooler):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgres://school37:school37@localhost:5432/school37

# ─── CMS / Auth ───────────────────────────────────────────────
# Сгенерируйте: openssl rand -base64 32  (минимум 16 символов)
CMS_SESSION_SECRET=change-this-to-a-long-random-string

CMS_ADMIN_EMAIL=admin@school37.local
CMS_ADMIN_PASSWORD=changeme

# ─── Сайт ─────────────────────────────────────────────────────
# Локально:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production (ваш домен на Vercel):
# NEXT_PUBLIC_SITE_URL=https://school37.vercel.app
